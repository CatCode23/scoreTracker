# Copy to .env.local for local development. NEVER commit a real .env file.
# The anon key is designed to be public; all data protection is enforced by RLS.
# NEVER put SUPABASE_SERVICE_ROLE_KEY (or any database password) here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=WOTB Tournament Tracker
# Must match the GitHub repository name, with leading and trailing slashes.
VITE_GITHUB_PAGES_BASE=/scoreTracker/
# Optional. Domain added to plain usernames at sign-in ("jsmith" -> "jsmith@wotb.local").
VITE_USERNAME_DOMAIN=wotb.local
